<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="//code.jquery.com/jquery-3.7.1.js"></script>
    <script src="//cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/4.1.1/js/dataTables.responsive.min.js"></script>

    <link rel="stylesheet" href="//cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
    <link href="https://cdn.datatables.net/responsive/4.1.1/css/responsive.dataTables.min.css" rel="stylesheet">
 
    <title>Admin Page</title>
</head>
<body>
    <table id="contact-table" class="display">
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Job Title</th>
                <th>Company</th>
                <th>LinkedIn URL</th>
                <th>Email Address</th>
                <th>Source</th>
                <th>Source Details</th>
                <th>Message</th>
                <th>Mailing List</th>
                <th>Email Format</th>
            </tr>
        </thead>
        <tbody>
            <% contacts.forEach( contact => { %>
                <tr>
                    <td><%= contact.first_name %></td>
                    <td><%= contact.last_name %></td>
                    <td><%= contact.job_title %></td>
                    <td><%= contact.company %></td>
                    <td><%= contact.linkedin %></td>
                    <td><%= contact.email %></td>
                    <td><%= contact.source %></td>
                    <td><%= contact.source_other %></td>
                    <td><%= contact.message %></td>
                    <td><%= contact.mailing_list ? "Yes" : "No" %></td>
                    <td><%= contact.email_format %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</body>
<script>
    new DataTable('#contact-table', {
            responsive: true
        });
</script>
</html>