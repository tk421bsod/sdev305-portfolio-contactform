<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <script defer src="/js/validation.js"></script>
    <title>Contact Form</title>
</head>
<body>
    <div id="main-content">
        <h1 id="header">Contact Form</h1>
        <p id="err"></p>
        <form id="form-body" action="/submit" method="post">
            <div class="form-fields">
                <div>
                    <label for="first_name">First Name</label>
                    <input type="text" id="first_name" name="first_name">
                </div>
                <div>
                    <label for="last_name">Last Name</label>
                    <input type="text" id="last_name" name="last_name">    
                </div>
                <div>
                    <label for="job_title">Job Title</label>
                    <input type="text" id="job_title" name="job_title">
                </div>
                <div>
                    <label for="company">Company</label>
                    <input type="text" id="company" name="company">
                </div>
                <div>
                    <label for="linkedin">LinkedIn URL</label>
                    <input type="text" id="linkedin" name="linkedin">
                </div>
                <div>
                    <label for="email">Email Address</label>
                    <input type="text" id="email" name="email">
                </div>
                <div>
                    <label for="source">How did we meet?</label>
                    <select id="source" name="source">
                        <option>Please select</option>
                        <option>Company event</option>
                        <option>LinkedIn connections</option>
                        <option>Other social media</option>
                        <option>Friends / family</option>
                        <option>Other</option>
                    </select>
                </div>
                <div>
                    <label for="source_other">Other (please specify)</label>
                    <input type="text" id="source_other" name="source_other">
                </div>
            </div>
            <label for="message">Message</label>
            <textarea id="message" name="message"></textarea>
            <div class="inline">
                <input type="checkbox" name="mailing_list" id="mailing_list" value="1"> 
                <label for="mailing_list">Please add me to your mailing list</label>
            </div>
            <p>Email Format</p>
            <div class="inline" id="email-formats">
                <input type="radio" name="email_format" value="html">
                <label for="email_format">HTML</label>
                <input type="radio" name="email_format" value="text">
                <label for="email_format">Text</label>
            </div>
            <button type="submit" id="submit-button">Submit</button>
        </form>
    </div>
</body>
</html>